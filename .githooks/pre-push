#!/bin/sh
# Privacy check before every push (enable once per clone: git config core.hooksPath .githooks).
# git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # deleting a remote branch sends nothing
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  python3 "$(git rev-parse --show-toplevel)/scripts/check_private.py" "$range" || status=1
done
exit $status
